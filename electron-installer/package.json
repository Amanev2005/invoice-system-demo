{
    "name": "invoice-system",
    "version": "1.0.0",
    "description": "Invoice Management System",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "pack": "electron-builder --dir",
        "prebuild": "npm run build-frontend",
        "build-frontend": "cd ../frontend && npm run build",
        "dist": "npm run prebuild && electron-builder"
    },
    "author": "Your Company",
    "license": "MIT",
    "dependencies": {
        "fs-extra": "^11.3.3",
        "pg": "^8.18.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "build": {
        "appId": "com.invoicesystem.app",
        "productName": "Invoice System",
        "forceCodeSigning": false,
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "pg-manager.js",
            "backend-manager.js",
            "loading.html",
            "icon.ico"
        ],
        "extraFiles": [
            {
                "from": "../MANUAL_BACKUP.bat",
                "to": "."
            }
        ],
        "extraResources": [
            {
                "from": "../backend",
                "to": "app/backend",
                "filter": [
                    "**/*",
                    "!**/__pycache__/**",
                    "!**/*.pyc",
                    "!**/venv/**",
                    "!**/env/**",
                    "!**/.git/**",
                    "!**/db.sqlite3",
                    "!**/backups/**"
                ]
            },
            {
                "from": "../frontend/dist",
                "to": "app/frontend"
            },
            {
                "from": "resources/python",
                "to": "python",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "resources/postgresql",
                "to": "postgresql",
                "filter": [
                    "**/*",
                    "!data",
                    "!data/**"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Invoice System",
            "perMachine": false,
            "allowElevation": true,
            "installerIcon": "icon.ico",
            "uninstallerIcon": "icon.ico",
            "installerHeaderIcon": "icon.ico",
            "deleteAppDataOnUninstall": false,
            "runAfterFinish": true,
            "license": "../LICENSE.txt"
        },
        "compression": "maximum",
        "artifactName": "${productName}-Setup-${version}.${ext}"
    }
}